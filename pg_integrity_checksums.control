# pg_integrity_checksums.control

comment = 'Checksum functions for PostgreSQL at page, cell, tuple, table, index and database levels'
default_version = '2.0.2'
module_pathname = '$libdir/pg_integrity_checksums'
relocatable = true
# Creating a C extension that reads relation storage should require a
# superuser.  The SQL functions themselves additionally enforce SELECT
# privileges (and superuser-only access for the database-level functions).
superuser = true
